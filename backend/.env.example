# TITAN Backend Environment Configuration

# Application Settings
NODE_ENV=development

SERVER_PORT=3000

APPLICATION_NAME=TITAN-Core-Platform


# Database Configuration

DATABASE_HOST=localhost
DATABASE_PORT=5432

DATABASE_NAME=titan_core_development
DATABASE_USER=titan_app
DATABASE_PASSWORD=CHANGE_ME_LOCAL_ONLY


# Prisma Connection Contracts
# Copy this file to the ignored .env file and replace placeholder passwords.
# Use separate least-privilege roles for the application and migrations.
# Never reuse development credentials in test, staging or production.
DATABASE_URL=postgresql://titan_app:CHANGE_ME_LOCAL_ONLY@localhost:5432/titan_core_development
SHADOW_DATABASE_URL=postgresql://titan_migrations:CHANGE_ME_LOCAL_ONLY@localhost:5432/titan_core_shadow

# Authentication Configuration

JWT_SECRET=

JWT_EXPIRATION=24h


# Logging Configuration

LOG_LEVEL=info
