generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                      String                   @id @default(uuid())
  name                    String
  slug                    String                   @unique
  status                  RecordStatus             @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  auditLogs               AuditLog[]
  organisations           Organisation[]
  sports                  Sport[]
  users                   User[]
  roles                   Role[]
  permissions             Permission[]
  athletes                Athlete[]
  athleteRelationships    AthleteRelationship[]
  athleteDigitalTwins     AthleteDigitalTwin[]
  performanceMetrics      PerformanceMetric[]
  performanceMeasurements PerformanceMeasurement[]
  exercises               Exercise[]

  workoutProgrammes WorkoutProgramme[]
  products          Product[]
}

model Sport {
  id                 String              @id @default(uuid())
  tenantId           String
  name               String
  slug               String
  status             RecordStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  performanceMetrics PerformanceMetric[] @relation("PerformanceMetricSportTenant")
  workoutProgrammes  WorkoutProgramme[]
  exercises          Exercise[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId], map: "Sport_id_tenantId_key")
  @@index([tenantId])
}

model Organisation {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    RecordStatus @default(ACTIVE)
  tenantId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  users     User[]
  athletes  Athlete[]
}

model User {
  id             String        @id @default(uuid())
  tenantId       String
  organisationId String?
  email          String
  passwordHash   String
  firstName      String?
  lastName       String?
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  auditLogs      AuditLog[]
  sessions       Session[]
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  userRoles      UserRole[]
  athletes       Athlete[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([organisationId])
}

model Athlete {
  id                      String                   @id @default(uuid())
  tenantId                String
  organisationId          String?
  userId                  String?
  firstName               String
  lastName                String
  dateOfBirth             DateTime?
  status                  RecordStatus             @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  organisation            Organisation?            @relation(fields: [organisationId], references: [id])
  user                    User?                    @relation(fields: [userId], references: [id])
  relationships           AthleteRelationship[]
  athleteDigitalTwins     AthleteDigitalTwin[]
  performanceMetrics      PerformanceMetric[]      @relation("PerformanceMetricAthleteTenant")
  performanceMeasurements PerformanceMeasurement[] @relation("PerformanceMeasurementAthleteTenant")
  workoutProgrammes       WorkoutProgramme[]       @relation("WorkoutProgrammeAthleteTenant")

  @@unique([id, tenantId], map: "Athlete_id_tenantId_key")
  @@index([tenantId])
  @@index([organisationId])
  @@index([userId])
}

model Role {
  id          String           @id @default(uuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(uuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([tenantId, name])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model Session {
  id           String        @id @default(uuid())
  userId       String
  refreshToken String        @unique
  jti          String        @unique
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id         String         @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  status     AuditLogStatus @default(SUCCESS)
  metadata   Json?
  createdAt  DateTime       @default(now())
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  user       User?          @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model SecurityEvent {
  id        String            @id @default(uuid())
  eventType SecurityEventType
  tenantId  String?
  userId    String?
  ipAddress String?
  userAgent String?
  requestId String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([eventType])
  @@index([tenantId])
  @@index([userId])
  @@index([ipAddress])
  @@index([requestId])
  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([tenantId, createdAt])
}

model AthleteRelationship {
  id               String                  @id @default(uuid())
  tenantId         String
  athleteId        String
  relationshipType AthleteRelationshipType
  relatedEntityId  String
  status           RecordStatus            @default(ACTIVE)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([tenantId])
  @@index([athleteId])
  @@index([athleteId, relationshipType])
  @@index([relatedEntityId])
}

model AthleteDigitalTwin {
  id        String       @id @default(uuid())
  tenantId  String
  athleteId String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([tenantId, athleteId])
  @@index([tenantId])
  @@index([athleteId])
}

model Exercise {
  id                String       @id @default(uuid())
  tenantId          String
  name              String
  slug              String
  description       String?
  movement          String
  muscleGroups      String[]
  equipment         String[]
  trainingObjective String
  difficulty        String
  trainingPhase     String?
  sportId           String?
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sport                  Sport?                                  @relation(fields: [sportId], references: [id])
  programmePrescriptions WorkoutProgrammeExercisePrescription[] @relation("WorkoutProgrammePrescriptionExerciseTenant")

  @@unique([tenantId, slug])
  @@unique([id, tenantId], map: "Exercise_id_tenantId_key")
  @@index([tenantId])
  @@index([sportId])
  @@index([tenantId, sportId])
}

model PerformanceMetric {
  id          String       @id @default(uuid())
  tenantId    String
  athleteId   String
  sportId     String
  name        String
  slug        String
  description String?
  unit        String?
  dataType    String
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  athlete                 Athlete                  @relation("PerformanceMetricAthleteTenant", fields: [athleteId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  sport                   Sport                    @relation("PerformanceMetricSportTenant", fields: [sportId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  performanceMeasurements PerformanceMeasurement[] @relation("PerformanceMeasurementMetricTenantAthlete")

  @@unique([tenantId, athleteId, sportId, slug])
  @@unique([id, tenantId, athleteId], map: "PerformanceMetric_id_tenantId_athleteId_key")
  @@index([tenantId])
  @@index([athleteId])
  @@index([sportId])
  @@index([tenantId, athleteId])
}

enum SecurityEventType {
  AUTHENTICATION_SUCCESS
  AUTHENTICATION_FAILURE
  AUTHORIZATION_FAILURE
  INVALID_AUTH_HEADER
  INVALID_TOKEN
  TOKEN_EXPIRED
  TOKEN_REFRESH_SUCCESS
  TOKEN_REFRESH_FAILURE
  TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  ACCOUNT_LOCKED
  SUSPICIOUS_ACTIVITY
  RATE_LIMIT_EXCEEDED
}

enum AthleteRelationshipType {
  TRAINER
  COACH
  TEAM
  ACADEMY
  CLUB
  PERFORMANCE_PROFESSIONAL
  ORGANISATION
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuditLogStatus {
  SUCCESS
  FAILURE
}

model WorkoutProgramme {
  id                     String       @id @default(uuid())
  tenantId               String
  athleteId              String
  name                   String
  description            String?
  goal                   String
  experience             String
  trainingFrequency      Int
  sessionDurationMinutes Int
  sportId                String?
  status                 RecordStatus @default(ACTIVE)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  tenant   Tenant                    @relation(fields: [tenantId], references: [id])
  athlete  Athlete                   @relation("WorkoutProgrammeAthleteTenant", fields: [athleteId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  sport    Sport?                    @relation(fields: [sportId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  sessions WorkoutProgrammeSession[]

  @@unique([id, tenantId], map: "WorkoutProgramme_id_tenantId_key")
  @@index([tenantId])
  @@index([athleteId])
  @@index([sportId])
  @@index([tenantId, athleteId])
}

model WorkoutProgrammeSession {
  id          String   @id @default(uuid())
  tenantId    String
  programmeId String
  ordinal     Int
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme    WorkoutProgramme                     @relation(fields: [programmeId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  prescriptions WorkoutProgrammeExercisePrescription[]

  @@unique([id, tenantId], map: "WorkoutProgrammeSession_id_tenantId_key")
  @@unique([programmeId, ordinal], map: "WorkoutProgrammeSession_programmeId_ordinal_key")
  @@index([tenantId, programmeId])
}

model WorkoutProgrammeExercisePrescription {
  id              String   @id @default(uuid())
  tenantId        String
  sessionId       String
  exerciseId      String
  ordinal         Int
  sets            Int
  repetitions     Int?
  durationSeconds Int?
  restSeconds     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session  WorkoutProgrammeSession @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  exercise Exercise                @relation("WorkoutProgrammePrescriptionExerciseTenant", fields: [exerciseId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sessionId, ordinal], map: "WorkoutProgrammeExercisePrescription_sessionId_ordinal_key")
  @@index([tenantId, sessionId])
  @@index([tenantId, exerciseId])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model Product {
  id              String          @id @default(uuid())
  tenantId        String
  name            String
  slug            String
  description     String?
  priceCents      Int
  currency        String
  billingInterval BillingInterval
  status          ProductStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  prices ProductPrice[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@index([billingInterval])
}

model ProductPrice {
  id              String          @id @default(uuid())
  productId       String
  amountMinor     Int
  currency        String
  billingInterval BillingInterval
  status          ProductStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([status])
  @@index([productId, status])
}

model PerformanceMeasurement {
  id         String   @id @default(uuid())
  tenantId   String
  athleteId  String
  metricId   String
  value      Decimal  @db.Decimal(20, 6)
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  sourceType String?
  sourceId String?
  sourceObservationId String?
  correctsMeasurementId String?

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  athlete Athlete           @relation("PerformanceMeasurementAthleteTenant", fields: [athleteId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  metric  PerformanceMetric @relation("PerformanceMeasurementMetricTenantAthlete", fields: [metricId, tenantId, athleteId], references: [id, tenantId, athleteId], onDelete: Restrict, onUpdate: Cascade)
  corrects PerformanceMeasurement? @relation("PerformanceMeasurementCorrections", fields: [correctsMeasurementId, tenantId, athleteId, metricId], references: [id, tenantId, athleteId, metricId], onDelete: Restrict, onUpdate: Cascade)
  correctedBy PerformanceMeasurement[] @relation("PerformanceMeasurementCorrections")

  @@unique([id, tenantId, athleteId, metricId], map: "PerformanceMeasurement_id_tenantId_athleteId_metricId_key")
  @@unique([tenantId, sourceType, sourceId, sourceObservationId], map: "PerformanceMeasurement_source_identity_key")
  @@unique([correctsMeasurementId], map: "PerformanceMeasurement_correctsMeasurementId_key")
  @@index([tenantId, athleteId, metricId, recordedAt])
  @@index([tenantId, athleteId])
  @@index([tenantId, athleteId, metricId, correctsMeasurementId], map: "PerformanceMeasurement_effective_lookup_idx")
}
