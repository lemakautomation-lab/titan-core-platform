generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  status               RecordStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  auditLogs            AuditLog[]
  organisations        Organisation[]
  sports               Sport[]
  users                User[]
  roles                Role[]
  permissions          Permission[]
  athletes             Athlete[]
  athleteRelationships AthleteRelationship[]
  athleteDigitalTwins  AthleteDigitalTwin[]
  performanceMetrics   PerformanceMetric[]
  exercises            Exercise[]

  workoutProgrammes WorkoutProgramme[]
  products          Product[]
}

model Sport {
  id                 String              @id @default(uuid())
  tenantId           String
  name               String
  slug               String
  status             RecordStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  performanceMetrics PerformanceMetric[]
  workoutProgrammes  WorkoutProgramme[]
  exercises          Exercise[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Organisation {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    RecordStatus @default(ACTIVE)
  tenantId  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  users     User[]
  athletes  Athlete[]
}

model User {
  id             String        @id @default(uuid())
  tenantId       String
  organisationId String?
  email          String
  passwordHash   String
  firstName      String?
  lastName       String?
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  auditLogs      AuditLog[]
  sessions       Session[]
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  userRoles      UserRole[]
  athletes       Athlete[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([organisationId])
}

model Athlete {
  id                  String                @id @default(uuid())
  tenantId            String
  organisationId      String?
  userId              String?
  firstName           String
  lastName            String
  dateOfBirth         DateTime?
  status              RecordStatus          @default(ACTIVE)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  organisation        Organisation?         @relation(fields: [organisationId], references: [id])
  user                User?                 @relation(fields: [userId], references: [id])
  relationships       AthleteRelationship[]
  athleteDigitalTwins AthleteDigitalTwin[]
  performanceMetrics  PerformanceMetric[]
  workoutProgrammes   WorkoutProgramme[]

  @@index([tenantId])
  @@index([organisationId])
  @@index([userId])
}

model Role {
  id          String           @id @default(uuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
}

model Permission {
  id          String           @id @default(uuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([tenantId, name])
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model Session {
  id           String        @id @default(uuid())
  userId       String
  refreshToken String        @unique
  jti          String        @unique
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id         String         @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  status     AuditLogStatus @default(SUCCESS)
  metadata   Json?
  createdAt  DateTime       @default(now())
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  user       User?          @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model SecurityEvent {
  id        String            @id @default(uuid())
  eventType SecurityEventType
  tenantId  String?
  userId    String?
  ipAddress String?
  userAgent String?
  requestId String?
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([eventType])
  @@index([tenantId])
  @@index([userId])
  @@index([ipAddress])
  @@index([requestId])
  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([tenantId, createdAt])
}

model AthleteRelationship {
  id               String                  @id @default(uuid())
  tenantId         String
  athleteId        String
  relationshipType AthleteRelationshipType
  relatedEntityId  String
  status           RecordStatus            @default(ACTIVE)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@index([tenantId])
  @@index([athleteId])
  @@index([athleteId, relationshipType])
  @@index([relatedEntityId])
}

model AthleteDigitalTwin {
  id        String       @id @default(uuid())
  tenantId  String
  athleteId String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])

  @@unique([tenantId, athleteId])
  @@index([tenantId])
  @@index([athleteId])
}

model Exercise {
  id                String       @id @default(uuid())
  tenantId          String
  name              String
  slug              String
  description       String?
  movement          String
  muscleGroups      String[]
  equipment         String[]
  trainingObjective String
  difficulty        String
  trainingPhase     String?
  sportId           String?
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sport  Sport? @relation(fields: [sportId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([sportId])
  @@index([tenantId, sportId])
}

model PerformanceMetric {
  id          String       @id @default(uuid())
  tenantId    String
  athleteId   String
  sportId     String
  name        String
  slug        String
  description String?
  unit        String?
  dataType    String
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])
  sport   Sport   @relation(fields: [sportId], references: [id])

  @@unique([tenantId, athleteId, sportId, slug])
  @@index([tenantId])
  @@index([athleteId])
  @@index([sportId])
  @@index([tenantId, athleteId])
}

enum SecurityEventType {
  AUTHENTICATION_SUCCESS
  AUTHENTICATION_FAILURE
  AUTHORIZATION_FAILURE
  INVALID_AUTH_HEADER
  INVALID_TOKEN
  TOKEN_EXPIRED
  TOKEN_REFRESH_SUCCESS
  TOKEN_REFRESH_FAILURE
  TOKEN_REUSE_DETECTED
  SESSION_REVOKED
  ACCOUNT_LOCKED
  SUSPICIOUS_ACTIVITY
  RATE_LIMIT_EXCEEDED
}

enum AthleteRelationshipType {
  TRAINER
  COACH
  TEAM
  ACADEMY
  CLUB
  PERFORMANCE_PROFESSIONAL
  ORGANISATION
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuditLogStatus {
  SUCCESS
  FAILURE
}

model WorkoutProgramme {
  id                     String       @id @default(uuid())
  tenantId               String
  athleteId              String
  name                   String
  description            String?
  goal                   String
  experience             String
  trainingFrequency      Int
  sessionDurationMinutes Int
  sportId                String?
  status                 RecordStatus @default(ACTIVE)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  athlete Athlete @relation(fields: [athleteId], references: [id])
  sport   Sport?  @relation(fields: [sportId], references: [id])

  @@index([tenantId])
  @@index([athleteId])
  @@index([sportId])
  @@index([tenantId, athleteId])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum BillingInterval {
  ONE_TIME
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model Product {
  id              String          @id @default(uuid())
  tenantId        String
  name            String
  slug            String
  description     String?
  priceCents      Int
  currency        String
  billingInterval BillingInterval
  status          ProductStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  prices ProductPrice[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
  @@index([billingInterval])
}

model ProductPrice {
  id              String          @id @default(uuid())
  productId       String
  amountMinor     Int
  currency        String
  billingInterval BillingInterval
  status          ProductStatus   @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([status])
  @@index([productId, status])
}
