function MetricCard({
  title,
  value,
  detail,
}: {
  title: string;
  value: string;
  detail: string;
}) {

  return (
    <article className="titan-metric-card">

      <span>
        {title}
      </span>

      <strong>
        {value}
      </strong>

      <small>
        {detail}
      </small>

    </article>
  );
}

function ModulePlaceholder({
  section,
}: {
  section: NavigationItem;
}) {

  return (
    <section className="titan-module-placeholder">

      <span className="titan-eyebrow">
        TITAN HEALTH MODULE
      </span>

      <h3>
        {section}
      </h3>

      <p>
